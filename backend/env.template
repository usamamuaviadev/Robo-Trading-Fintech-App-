# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/robo-advisor

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email (Nodemailer)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Zoya API - Halal Asset Filtering (GraphQL)
# Dashboard & API key: https://developer.zoya.finance/dashboard
# Do NOT use api.zoya.com (does not resolve). Use developer.zoya.finance/graphql.
ZOYA_GRAPHQL_URL=https://developer.zoya.finance/graphql
ZOYA_API_KEY=your-api-key-from-dashboard

# Broker API - Market Data
# Options: 'demo', 'twelvedata', 'ice', 'custom'
BROKER_API_TYPE=twelvedata
BROKER_API_BASE_URL=https://api.broker.com/v1
BROKER_API_KEY=your-twelve-data-api-key

# Twelve Data (Free tier: 800 requests/day, 8 requests/min)
# Supports Saudi symbols directly (e.g., 2222.SR, 2010.SR)
# Get free API key at: https://twelvedata.com/
TWELVEDATA_API_KEY=your-twelve-data-api-key

# Demo Mode (set to false in production)
DEMO_MODE=true

# OpenAI/Anthropic (for Chatbot - optional)
OPENAI_API_KEY=your-openai-api-key
# OR
ANTHROPIC_API_KEY=your-anthropic-api-key
