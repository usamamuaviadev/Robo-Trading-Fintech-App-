		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Send OTP (Phone) - START HERE",
					"request": {
						"description": "Step 1: Send OTP to phone number for registration\n\nAfter this, you'll receive OTP code (check console in demo mode)",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"+966501234567\",\n  \"purpose\": \"registration\",\n  \"type\": \"phone\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/send-otp",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "send-otp"]
						}
					}
				},
				{
					"name": "2. Verify OTP",
					"request": {
						"description": "Step 2: Verify the OTP code you received\n\nUse the code from Step 1 (demo mode: use 12345)",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"+966501234567\",\n  \"code\": \"12345\",\n  \"purpose\": \"registration\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/verify-otp",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "verify-otp"]
						}
					}
				},
				{
					"name": "Check Phone (Debug)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"+966501234567\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/check-phone",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "check-phone"]
						}
					}
				},
				{
					"name": "3. Register - SAVE TOKEN!",
					"request": {
						"description": "Step 3: Register new user\n\n⚠️ IMPORTANT: Copy the 'token' from response and paste it into 'auth_token' variable!\n\nAfter this, you can use all protected APIs.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"+966501234567\",\n  \"password\": \"Test@1234\",\n  \"code\": \"12345\",\n  \"email\": \"user@example.com\",\n  \"investmentProfile\": {\n    \"primaryGoal\": \"retirement\",\n    \"withdrawalTimeline\": \"3to5\",\n    \"monthlyDepositDescription\": \"medium\",\n    \"investmentObjective\": \"growth\",\n    \"riskTolerance\": \"longterm\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login (Alternative to Register)",
					"request": {
						"description": "For existing users: Login with phone and password\n\n⚠️ IMPORTANT: Copy the 'token' from response and paste it into 'auth_token' variable!",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"+966501234567\",\n  \"password\": \"Test@1234\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Get Current User (After Login/Register)",
					"request": {
						"description": "Get your user profile data\n\nRequires: auth_token (set after login/register)",
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		},
