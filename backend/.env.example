# CORS allowed origins (comma-separated). localhost:3000, 8082, 5173 are always allowed for admin/app.
# FRONTEND_URL=http://localhost:3000,https://your-admin.up.railway.app

# Demo Mode (set to true to enable demo mode - OTP codes will be logged instead of sent)
DEMO_MODE=true

# ---------- Alpaca (US market brokerage + stocks data) ----------
# Broker Dashboard: https://broker-app.alpaca.markets/login
# Sign up (trading + free market data): https://app.alpaca.markets/signup
# Broker API: Basic Auth (Client ID + Secret) – keys stay in backend only.
# Use Broker API keys from Broker Dashboard for subaccounts; ALPACA_API_* for market data (latest price).
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
# Sandbox (default true): use sandbox for Broker and Data to avoid real money
ALPACA_BROKER_SANDBOX=true
ALPACA_DATA_SANDBOX=true
# Use Alpaca for market data (prices) and optionally for brokerage
BROKER_API_TYPE=alpaca

# ---------- Zoya (halal screening for /api/market/halal-stocks) ----------
# Dashboard & API key: https://developer.zoya.finance/dashboard
# Docs: https://developer.zoya.finance/docs
# GraphQL API; sandbox is free. If Zoya is unreachable, halal-stocks still returns data.
ZOYA_API_KEY=
ZOYA_GRAPHQL_URL=
# Optional: set to false for live data (requires subscription)
ZOYA_SANDBOX=true

# ---------- Admin panel (static login) ----------
# Used by POST /api/admin/login. Admin UI uses these same credentials.
ADMIN_EMAIL=admin@robo.com
ADMIN_PASSWORD=Admin@123

# ---------- Gemini (AI chatbot) ----------
# Get API key: https://aistudio.google.com/app/apikey
# gemini-1.5-flash, gemini-1.5-pro use v1 API; gemini-2.5-flash, gemini-2.0-flash, gemini-3-* use v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
